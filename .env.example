# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.
# Na Vercel, estes mesmos nomes são cadastrados em Settings → Environment Variables.

GOOGLE_PLACES_API_KEY=cole_sua_chave_aqui

# Travas de segurança (cada página de 20 resultados = 1 consulta).
# O Google dá 1.000 consultas grátis por mês nesse tipo de busca.
LIMITE_DIARIO=30
LIMITE_MENSAL=900

# Login. Na Vercel é obrigatório; no computador, sem SENHA_ACESSO não pede login.
# SENHA_ACESSO: 12 caracteres ou mais.
# SEGREDO_SESSAO: 32+ caracteres aleatórios. Para gerar, rode no terminal:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
SENHA_ACESSO=
SEGREDO_SESSAO=

# Upstash Redis (contador na Vercel). A Vercel cria estas duas sozinha ao
# conectar o Upstash. No computador, só preencha se quiser que o contador do PC
# e o da Vercel somem juntos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
